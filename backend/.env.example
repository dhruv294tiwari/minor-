# MAIT AI College Information Assistant - Environment Configuration

# Application Settings
PROJECT_NAME="MAIT AI College Information Assistant"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Database (SQLite for local development, easily switchable to PostgreSQL)
DATABASE_URL=sqlite:///./mait_assistant.db

# JWT & Authentication
SECRET_KEY=mait_super_secret_jwt_key_change_in_production_2026_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration (Set LLM_ENABLED=false for offline intelligent mock mode)
LLM_ENABLED=false
LLM_PROVIDER=gemini # Options: gemini, openai, mock
LLM_API_KEY=YOUR_GEMINI_OR_OPENAI_API_KEY_HERE
LLM_MODEL=gemini-1.5-flash # or gpt-4o-mini

# CORS Settings (frontend origin)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]
